# Blockchain Deployment – Environment Variables
# Copiez ce fichier en .env et adaptez les valeurs

# ---- Sepolia ----
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/votre_projet_id
PRIVATE_KEY_DEPLOYER=0x...  # Clé privée pour Sepolia

# ---- Mainnet ----
ETH_MAINNET_RPC=https://mainnet.infura.io/v3/votre_projet_id
BNB_MAINNET_RPC=https://bsc-dataseed.binance.org
MAINNET_DEPLOYER_PRIVATE_KEY=0x...  # Clé privée pour mainnet

# ---- Etherscan (pour vérification) ----
ETHERSCAN_API_KEY=votre_cle_api
