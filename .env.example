# ============================================================
# Yusuf-Grondona System – Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Base de données ----------
DATABASE_PATH=./data/yusuf_grondona.db

# ---------- JWT ----------
JWT_SECRET_KEY=votre_cle_secrete_ici
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Blockchain (Sepolia / Mainnet) ----------
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/votre_projet_id
ETH_MAINNET_RPC=https://mainnet.infura.io/v3/votre_projet_id
BNB_MAINNET_RPC=https://bsc-dataseed.binance.org
PRIVATE_KEY_DEPLOYER=0x...
PRIVATE_KEY_ADMIN=0x...

# ---------- Smart Contracts ----------
YGDAO_CONTRACT_ADDRESS=0x...
YG_GOVERNOR_ADDRESS=0x...
TIMELOCK_ADDRESS=0x...
MULTISIG_CRD_ADDRESS=0x...
ZAKAT_TRACKER_ADDRESS=0x...
CARBON_CREDIT_ADDRESS=0x...
REPUTATION_TOKEN_ADDRESS=0x...

# ---------- Chainlink ----------
CHAINLINK_ETH_USD_ADDRESS=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_BNB_USD_ADDRESS=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE

# ---------- Monitoring ----------
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---------- IoT / MQTT ----------
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=yusuf/warehouse

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=votre_token
TELEGRAM_CHAT_ID=votre_chat_id
SMTP_USER=alerts@yusuf-grondona.com
SMTP_PASSWORD=votre_mdp

# ---------- API External ----------
TRADING_ECONOMICS_KEY=votre_cle
ETHERSCAN_API_KEY=votre_cle
INFURA_PROJECT_ID=votre_projet_id

# ---------- Deployment ----------
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://admin.yusuf-grondona.com,https://share.streamlit.io
